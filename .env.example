# Postgres connection string (Supabase transaction pooler, port 6543).
DATABASE_URL=

# Supabase project (browser-visible).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Web Push / reminder notifications ---------------------------------------
# Generate a VAPID key pair once with:  npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY must hold the SAME value as VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret the reminder dispatch cron must send as `Authorization: Bearer <value>`.
# Vercel Cron sends this automatically when CRON_SECRET is set on the project.
CRON_SECRET=
